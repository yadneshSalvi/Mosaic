{
  "name": "mosaic-evidence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "samples": "tsx scripts/generate-samples.ts",
    "start": "tsx server/index.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/*.ts\" \"scripts/*.ts\" \"tests/*.ts\""
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
